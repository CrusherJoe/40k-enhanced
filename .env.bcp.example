# BCP credentials for automatic token refresh (copy to .env.bcp — which is gitignored; NEVER commit real creds).
# tools/bcp_auth.py logs in via AWS Cognito and caches/refreshes the access token, so pulls never need a
# hand-pasted token. Precedence: cached token -> refresh token -> email+password -> manual BCP_TOKEN.

# Recommended: your BCP login (auto-refreshes indefinitely)
BCP_EMAIL=you@example.com
BCP_PASSWORD=your-bcp-password

# Optional alternatives:
# BCP_REFRESH_TOKEN=eyJ...   # a Cognito refresh token (no password stored; long-lived)
# BCP_TOKEN=eyJ...           # a manually-pasted access token (last-resort, ~1h)
