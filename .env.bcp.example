# BCP credentials for AUTOMATIC, hands-free tokens (copy to .env.bcp — gitignored; NEVER commit real creds).
#
# BCP's API only accepts tokens minted through its real web login (auth.bestcoastpairings.com), so a headless
# Chromium (tools/bcp_login/login.mjs) logs in with these creds and hands the token to the pull tools. You
# never paste a token. tools/bcp_auth.py caches it (~1h) and re-logs in automatically when it expires.
#
# One-time deps: node + `npm --prefix tools/bcp_login install` +
#   `npx --prefix tools/bcp_login playwright install --with-deps chromium`.

BCP_EMAIL=you@example.com
BCP_PASSWORD=your-bcp-password

# Optional manual fallback if node/browser is unavailable (a browser access token, ~1h; DevTools console:
#   Object.entries(localStorage).filter(([k])=>/accessToken/.test(k)).forEach(([,v])=>console.log(v)) )
# BCP_TOKEN=eyJ...
