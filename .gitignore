# Large GW source-reference PDFs (see docs/sources/SOURCES.md to re-download).
# Generated deliverable PDFs under docs/reports/ ARE committed.
docs/sources/*.pdf

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Scratch / extractor working files (the bundle + fetched HTML are huge)
tools/app.js
tools/mfm.html
tools/*.yaml
tools/mfm_chunks/
tools/*.json

# Personal Claude Code settings (permissions, etc.)
.claude/settings.local.json

# Raw external source clones + caches (re-fetchable; only normalized data is committed)
data/_src/
data/mfm/raw/

# cron logs (local)
logs/
# generated dossiers/runbooks, one folder per list (regenerate with wh.sim.dossier)
/reports/
.env.bcp
www.bestcoastpairings.com.har
*.har
# BCP tournament DBs ARE committed (private repo) -- they are ingested data we built.
data/bcp/*.sqlite-wal
data/bcp/*.sqlite-shm
data/bcp/*-archetypes.json

# BCP token cache (auto-generated by tools/bcp_auth.py — never commit tokens)
data/.bcp_token_cache.json

# Playwright login helper — do not commit deps/browsers
tools/bcp_login/node_modules/
tools/bcp_login/package-lock.json
